#!/usr/bin/env bash
# =============================================================================
# huawei-connect — Huawei phone integration for Linux
# Alternative to Huawei Share / Multi-Screen Collaboration
# Features: file transfer, clipboard sync, notifications, screen mirroring
# =============================================================================

set -euo pipefail

# --- Configuration -----------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/huawei-connect"
CONFIG_FILE="$CONFIG_DIR/config"
KNOWN_DEVICES_FILE="$CONFIG_DIR/known_devices"
LOG_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/huawei-connect.log"

# --- Colours -----------------------------------------------------------------
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
CYN='\033[0;36m'
MAG='\033[0;35m'
BLD='\033[1m'
RST='\033[0m'

# --- Helpers -----------------------------------------------------------------
info()  { echo -e "${BLU}•${RST} $*"; }
ok()    { echo -e "${GRN}✓${RST} $*"; }
warn()  { echo -e "${YLW}!${RST} $*"; }
err()   { echo -e "${RED}✗${RST} $*" >&2; }
hdr()   { echo -e "\n${BLD}${CYN}$*${RST}"; }
die()   { err "$*"; exit 1; }

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

# --- Setup -------------------------------------------------------------------
init_config() {
    mkdir -p "$CONFIG_DIR"
    touch "$KNOWN_DEVICES_FILE"
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat > "$CONFIG_FILE" << 'EOF'
# Huawei Connect Configuration
# Device name shown to phones
DEVICE_NAME="Huawei-MateBook"

# Receive directory for files
RECEIVE_DIR="$HOME/Downloads/HuaweiShare"

# Enable clipboard sync (requires kdeconnect-cli)
CLIPBOARD_SYNC=true

# Enable notification sync
NOTIFICATION_SYNC=true

# Auto-accept files from known devices
AUTO_ACCEPT_KNOWN=true

# QR code server port
QR_PORT=8080
EOF
    fi
}

# --- Dependencies ------------------------------------------------------------
check_deps() {
    local missing=()
    
    command -v kdeconnect-cli &>/dev/null || missing+=("kdeconnect")
    command -v qrencode &>/dev/null || missing+=("qrencode")
    command -v scrcpy &>/dev/null || missing+=("scrcpy")
    command -v adb &>/dev/null || missing+=("adb")
    
    if [[ ${#missing[@]} -gt 0 ]]; then
        warn "Missing dependencies: ${missing[*]}"
        info "Install with: sudo apt install ${missing[*]}"
        return 1
    fi
    ok "All dependencies installed"
    return 0
}

# =============================================================================
# STATUS — Show connection status
# =============================================================================
cmd_status() {
    hdr "Huawei Connect Status"
    
    # Check KDE Connect daemon
    if pgrep -x "kdeconnectd" > /dev/null; then
        ok "KDE Connect daemon running"
        
        # List paired devices
        local devices
        devices=$(kdeconnect-cli --list-available 2>/dev/null || true)
        if [[ -n "$devices" ]]; then
            echo ""
            echo "  Paired/Available devices:"
            echo "$devices" | while read -r line; do
                echo "    $line"
            done
        else
            info "  No devices paired yet"
        fi
    else
        warn "KDE Connect daemon not running"
        info "  Start with: kdeconnect-cli --refresh"
    fi
    
    # ADB status
    if command -v adb &>/dev/null; then
        echo ""
        local adb_devices
        adb_devices=$(adb devices -l 2>/dev/null | grep -v "List of devices" | grep -v "^$" || true)
        if [[ -n "$adb_devices" ]]; then
            ok "ADB device connected:"
            echo "$adb_devices" | sed 's/^/    /'
        else
            info "  No ADB devices connected"
        fi
    fi
    
    # Check for known devices file
    if [[ -s "$KNOWN_DEVICES_FILE" ]]; then
        echo ""
        ok "Known devices:"
        cat "$KNOWN_DEVICES_FILE" | sed 's/^/    /'
    fi
    
    echo ""
}

# =============================================================================
# PAIR — Pair with a new device
# =============================================================================
cmd_pair() {
    hdr "Pair with Huawei Device"
    
    check_deps || return 1
    
    info "Starting KDE Connect..."
    
    # Ensure KDE Connect is running
    if ! pgrep -x "kdeconnectd" > /dev/null; then
        kdeconnect-cli --refresh &
        sleep 2
    fi
    
    # Generate QR code for easy pairing
    local hostname
    hostname=$(hostname)
    local pair_url="kdeconnect://pair?host=$hostname"
    
    echo ""
    info "On your Huawei phone:"
    echo "  1. Install 'KDE Connect' from AppGallery or Play Store"
    echo "  2. Open KDE Connect and tap 'Pair a new device'"
    echo "  3. Select your laptop: $hostname"
    echo ""
    
    # Show QR code if qrencode is available
    if command -v qrencode &>/dev/null; then
        info "Or scan this QR code:"
        echo ""
        qrencode -t ANSIUTF8 "$pair_url" 2>/dev/null || \
            qrencode -t ANSI "$pair_url"
        echo ""
    fi
    
    # Wait for device
    info "Waiting for device to pair... (Ctrl+C to cancel)"
    local prev_devices
    prev_devices=$(kdeconnect-cli --list-available 2>/dev/null || true)
    
    while true; do
        sleep 2
        local current_devices
        current_devices=$(kdeconnect-cli --list-available 2>/dev/null || true)
        
        # Check for new devices
        if [[ "$current_devices" != "$prev_devices" ]]; then
            local new_device
            new_device=$(echo "$current_devices" | grep -vF "$prev_devices" | head -1 || true)
            if [[ -n "$new_device" ]]; then
                echo ""
                ok "New device detected: $new_device"
                
                # Add to known devices
                local device_id
                device_id=$(echo "$new_device" | grep -oE '^[0-9a-f:]+' | head -1 || true)
                if [[ -n "$device_id" ]]; then
                    echo "$device_id $(date +%Y-%m-%d)" >> "$KNOWN_DEVICES_FILE"
                    ok "Added to known devices"
                fi
                
                echo ""
                info "Requesting pairing..."
                kdeconnect-cli --pair "$device_id" 2>/dev/null || true
                break
            fi
        fi
    done
}

# =============================================================================
# SHARE — Send file to phone
# =============================================================================
cmd_share() {
    local file="${1:-}"
    [[ -n "$file" ]] || die "Usage: huawei-connect share <file>"
    [[ -f "$file" ]] || die "File not found: $file"
    
    hdr "Send File to Phone"
    
    check_deps || return 1
    
    # Get list of paired devices
    local devices
    devices=$(kdeconnect-cli --list-available 2>/dev/null | grep -oE '^[0-9a-f:]+' || true)
    
    if [[ -z "$devices" ]]; then
        err "No paired devices found. Run: huawei-connect pair"
        return 1
    fi
    
    # If multiple devices, let user choose
    local device_id
    if [[ $(echo "$devices" | wc -l) -gt 1 ]]; then
        echo "Multiple devices found:"
        local i=1
        while IFS= read -r dev; do
            echo "  $i) $dev"
            ((i++))
        done <<< "$devices"
        
        read -rp "Select device (1-$((i-1))): " choice
        device_id=$(echo "$devices" | sed -n "${choice}p")
    else
        device_id="$devices"
    fi
    
    info "Sending $(basename "$file") to device..."
    kdeconnect-cli --share "$file" --device "$device_id" && \
        ok "File sent successfully" || \
        err "Failed to send file"
}

# =============================================================================
# RECEIVE — Accept files from phone
# =============================================================================
cmd_receive() {
    hdr "Receive Files from Phone"
    
    source "$CONFIG_FILE" 2>/dev/null || true
    local receive_dir="${RECEIVE_DIR:-$HOME/Downloads/HuaweiShare}"
    mkdir -p "$receive_dir"
    
    ok "Receive directory: $receive_dir"
    
    # Enable KDE Connect file sharing
    if command -v kdeconnect-cli &>/dev/null; then
        info "KDE Connect file sharing is active"
        info "Files will be saved to: $receive_dir"
        
        # Monitor for new files
        info "Monitoring for incoming files... (Ctrl+C to stop)"
        local last_count
        last_count=$(ls -1 "$receive_dir" 2>/dev/null | wc -l)
        
        while true; do
            sleep 2
            local current_count
            current_count=$(ls -1 "$receive_dir" 2>/dev/null | wc -l)
            
            if [[ $current_count -gt $last_count ]]; then
                local new_files
                new_files=$(ls -1t "$receive_dir" 2>/dev/null | head -n $((current_count - last_count)))
                echo ""
                ok "New file(s) received:"
                echo "$new_files" | sed 's/^/  /'
                last_count=$current_count
            fi
        done
    fi
}

# =============================================================================
# CLIPBOARD — Sync clipboard with phone
# =============================================================================
cmd_clipboard() {
    hdr "Clipboard Sync"
    
    check_deps || return 1
    
    local devices
    devices=$(kdeconnect-cli --list-available 2>/dev/null | grep -oE '^[0-9a-f:]+' | head -1 || true)
    
    if [[ -z "$devices" ]]; then
        err "No paired device found"
        return 1
    fi
    
    local current_clipboard
    current_clipboard=$(xclip -selection clipboard -o 2>/dev/null || wl-paste 2>/dev/null || true)
    
    case "${1:-status}" in
        status)
            info "Current clipboard: ${current_clipboard:0:50}..."
            ;;
            
        send)
            info "Sending clipboard to phone..."
            kdeconnect-cli --share-text "$current_clipboard" --device "$devices" && \
                ok "Clipboard sent" || \
                err "Failed to send"
            ;;
            
        receive)
            # This would require a custom KDE Connect plugin
            warn "Auto-receive not implemented - use KDE Connect GUI"
            ;;
            
        monitor)
            info "Monitoring clipboard... (Ctrl+C to stop)"
            local last_clipboard="$current_clipboard"
            
            while true; do
                sleep 1
                current_clipboard=$(xclip -selection clipboard -o 2>/dev/null || wl-paste 2>/dev/null || true)
                
                if [[ "$current_clipboard" != "$last_clipboard" && -n "$current_clipboard" ]]; then
                    ok "Clipboard changed, sending to phone..."
                    kdeconnect-cli --share-text "$current_clipboard" --device "$devices" 2>/dev/null || true
                    last_clipboard="$current_clipboard"
                fi
            done
            ;;
    esac
}

# =============================================================================
# SCREEN — Screen mirroring / control
# =============================================================================
cmd_screen() {
    hdr "Screen Mirroring"
    
    if ! command -v scrcpy &>/dev/null; then
        die "scrcpy not installed. Install with: sudo apt install scrcpy"
    fi
    
    # Check for connected ADB device
    local adb_device
    adb_device=$(adb devices -l 2>/dev/null | grep -v "List of devices" | grep -v "^$" | head -1 | awk '{print $1}' || true)
    
    if [[ -z "$adb_device" ]]; then
        warn "No ADB device found"
        info "Enable USB debugging on your phone:"
        echo "  Settings → About phone → Tap 'Build number' 7 times"
        echo "  Settings → Developer options → USB debugging"
        echo "  Connect phone via USB and allow debugging"
        echo ""
        info "Or connect wirelessly:"
        echo "  adb tcpip 5555"
        echo "  adb connect <phone-ip>:5555"
        return 1
    fi
    
    ok "Found device: $adb_device"
    
    local mode="${1:-mirror}"
    
    case "$mode" in
        mirror)
            info "Starting screen mirroring... (Ctrl+C to stop)"
            scrcpy --serial "$adb_device" \
                   --window-title "Huawei Phone" \
                   --stay-awake \
                   --turn-screen-off \
                   --show-touches \
                   2>/dev/null || \
            scrcpy --serial "$adb_device"
            ;;
            
        record)
            local filename="phone_recording_$(date +%Y%m%d_%H%M%S).mp4"
            info "Recording to: $filename"
            scrcpy --serial "$adb_device" \
                   --record "$filename" \
                   --no-display \
                   --stay-awake
            ok "Recording saved: $filename"
            ;;
            
        control)
            info "Starting remote control (no display)..."
            scrcpy --serial "$adb_device" \
                   --no-display \
                   --stay-awake \
                   --show-touches
            ;;
            
        audio)
            info "Forwarding audio from phone..."
            scrcpy --serial "$adb_device" \
                   --no-display \
                   --audio \
                   --stay-awake
            ;;
    esac
}

# =============================================================================
# SMS — Send SMS from computer
# =============================================================================
cmd_sms() {
    hdr "SMS Messaging"
    
    check_deps || return 1
    
    local devices
    devices=$(kdeconnect-cli --list-available 2>/dev/null | grep -oE '^[0-9a-f:]+' | head -1 || true)
    
    if [[ -z "$devices" ]]; then
        err "No paired device found"
        return 1
    fi
    
    local number="${1:-}"
    local message="${2:-}"
    
    if [[ -z "$number" ]]; then
        read -rp "Phone number: " number
    fi
    
    if [[ -z "$message" ]]; then
        read -rp "Message: " message
    fi
    
    # KDE Connect doesn't directly support SMS sending via CLI
    # This would require SMS plugin or alternative method
    info "Opening KDE Connect SMS window..."
    kdeconnect-cli --device "$devices" --send-sms 2>/dev/null || \
        warn "SMS feature requires KDE Connect SMS plugin or GUI"
}

# =============================================================================
# NOTIFICATIONS — Notification sync
# =============================================================================
cmd_notifications() {
    hdr "Notification Sync"
    
    check_deps || return 1
    
    case "${1:-status}" in
        status)
            # Show last notifications
            if [[ -f "$LOG_FILE" ]]; then
                info "Recent notifications:"
                grep "Notification" "$LOG_FILE" 2>/dev/null | tail -10 || \
                    info "No notifications logged yet"
            fi
            ;;
            
        enable)
            info "Notification sync enabled via KDE Connect"
            info "Configure in KDE Connect settings → Notifications"
            ;;
            
        test)
            # Send test notification to phone
            local devices
            devices=$(kdeconnect-cli --list-available 2>/dev/null | grep -oE '^[0-9a-f:]+' | head -1 || true)
            if [[ -n "$devices" ]]; then
                kdeconnect-cli --ping-msg "Test from MateBook" --device "$devices" && \
                    ok "Test notification sent"
            fi
            ;;
    esac
}

# =============================================================================
# FIND — Find my phone
# =============================================================================
cmd_find() {
    hdr "Find My Phone"
    
    check_deps || return 1
    
    local devices
    devices=$(kdeconnect-cli --list-available 2>/dev/null | grep -oE '^[0-9a-f:]+' | head -1 || true)
    
    if [[ -z "$devices" ]]; then
        err "No paired device found"
        return 1
    fi
    
    info "Ringing phone..."
    kdeconnect-cli --ring --device "$devices" && \
        ok "Phone is ringing" || \
        err "Failed to ring phone"
}

# =============================================================================
# WEB — Start web interface for file sharing
# =============================================================================
cmd_web() {
    hdr "Web File Sharing"
    
    source "$CONFIG_FILE" 2>/dev/null || true
    local port="${QR_PORT:-8080}"
    local receive_dir="${RECEIVE_DIR:-$HOME/Downloads/HuaweiShare}"
    
    mkdir -p "$receive_dir"
    
    # Check for Python or other web server
    local ip
    ip=$(hostname -I | awk '{print $1}')
    
    info "Starting web server on http://${ip}:${port}"
    info "Share directory: $receive_dir"
    
    # Generate QR code
    if command -v qrencode &>/dev/null; then
        local url="http://${ip}:${port}"
        echo ""
        qrencode -t ANSIUTF8 "$url" 2>/dev/null || qrencode -t ANSI "$url"
        echo ""
        info "Scan QR code with your phone"
    fi
    
    # Start simple Python web server for file upload
    if command -v python3 &>/dev/null; then
        cd "$receive_dir" && python3 -m http.server "$port"
    elif command -v python &>/dev/null; then
        cd "$receive_dir" && python -m SimpleHTTPServer "$port"
    else
        die "Python not found - cannot start web server"
    fi
}

# =============================================================================
# HELP
# =============================================================================
cmd_help() {
    cat << 'EOF'

huawei-connect — Huawei phone integration for Linux
Alternative to Huawei Share / Multi-Screen Collaboration

Usage: huawei-connect <command> [args]

Connection & Pairing:
  pair                Pair with a new Huawei device (QR code)
  status              Show connection status and paired devices

File Transfer:
  share <file>        Send file to paired phone
  receive             Monitor for incoming files
  web                 Start web server for easy file transfer (with QR code)

Screen & Control:
  screen mirror       Mirror phone screen to laptop
  screen record       Record phone screen to file
  screen control      Control phone without displaying
  screen audio        Forward phone audio to laptop

Clipboard & Notifications:
  clipboard status    Show current clipboard status
  clipboard send      Send clipboard to phone
  clipboard monitor   Auto-sync clipboard changes
  notifications       Manage notification sync

Messaging:
  sms [number] [msg]  Send SMS from computer

Device Management:
  find                Ring phone to locate it

Setup:
  deps                Check/install dependencies

Examples:
  huawei-connect pair
  huawei-connect share ~/Documents/file.pdf
  huawei-connect screen mirror
  huawei-connect clipboard monitor

Dependencies:
  - kdeconnect: File transfer, notifications, clipboard
  - scrcpy: Screen mirroring and control
  - adb: Android debug bridge
  - qrencode: QR code generation

EOF
}

# =============================================================================
# DEPS — Check and install dependencies
# =============================================================================
cmd_deps() {
    hdr "Checking Dependencies"
    
    local to_install=()
    
    # Check each dependency
    if ! command -v kdeconnect-cli &>/dev/null; then
        to_install+=("kdeconnect")
        warn "kdeconnect not found"
    else
        ok "kdeconnect"
    fi
    
    if ! command -v scrcpy &>/dev/null; then
        to_install+=("scrcpy")
        warn "scrcpy not found"
    else
        ok "scrcpy"
    fi
    
    if ! command -v adb &>/dev/null; then
        to_install+=("adb")
        warn "adb not found"
    else
        ok "adb"
    fi
    
    if ! command -v qrencode &>/dev/null; then
        to_install+=("qrencode")
        warn "qrencode not found"
    else
        ok "qrencode"
    fi
    
    if [[ ${#to_install[@]} -gt 0 ]]; then
        echo ""
        info "Install missing packages:"
        echo "  sudo apt update"
        echo "  sudo apt install ${to_install[*]}"
        
        # For scrcpy which might need snap
        if [[ " ${to_install[*]} " =~ " scrcpy " ]]; then
            echo ""
            info "Alternative for scrcpy:"
            echo "  sudo snap install scrcpy"
        fi
    else
        echo ""
        ok "All dependencies installed!"
    fi
}

# =============================================================================
# Main dispatcher
# =============================================================================
main() {
    init_config
    
    local cmd="${1:-help}"
    shift 2>/dev/null || true
    
    case "$cmd" in
        status|s)               cmd_status "$@" ;;
        pair|p)               cmd_pair "$@" ;;
        share|send)           cmd_share "$@" ;;
        receive|recv|r)       cmd_receive "$@" ;;
        web|qr)               cmd_web "$@" ;;
        screen|scrcpy|scr)    cmd_screen "$@" ;;
        clipboard|clip|cb)    cmd_clipboard "$@" ;;
        notifications|notif)  cmd_notifications "$@" ;;
        sms|message|msg)      cmd_sms "$@" ;;
        find|ring|locate)     cmd_find "$@" ;;
        deps|dependencies)    cmd_deps "$@" ;;
        help|-h|--help)       cmd_help ;;
        *)
            err "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
