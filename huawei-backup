#!/usr/bin/env bash
# =============================================================================
# huawei-backup — Automated backup and sync for Huawei MateBook
# Features: local backup, cloud sync, system snapshots, selective sync
# =============================================================================

set -euo pipefail

# --- Configuration -----------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/huawei-backup"
CONFIG_FILE="$CONFIG_DIR/config"
LOG_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/huawei-backup.log"
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/huawei-backup.pid"

# Default backup locations
DEFAULT_LOCAL_BACKUP="$HOME/Backups"
DEFAULT_CLOUD_DIR="$HOME/Nextcloud"  # or Dropbox, Google Drive, etc.

# --- Colours -----------------------------------------------------------------
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
CYN='\033[0;36m'
MAG='\033[0;35m'
BLD='\033[1m'
RST='\033[0m'

# --- Helpers -----------------------------------------------------------------
info()  { echo -e "${BLU}•${RST} $*"; }
ok()    { echo -e "${GRN}✓${RST} $*"; }
warn()  { echo -e "${YLW}!${RST} $*"; }
err()   { echo -e "${RED}✗${RST} $*" >&2; }
hdr()   { echo -e "\n${BLD}${CYN}$*${RST}"; }
die()   { err "$*"; exit 1; }

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE"
}

init_config() {
    mkdir -p "$CONFIG_DIR"
    
    if [[ ! -f "$CONFIG_FILE" ]]; then
        cat > "$CONFIG_FILE" << EOF
# Huawei Backup Configuration
# Generated: $(date)

# Local backup settings
LOCAL_BACKUP_DIR="$DEFAULT_LOCAL_BACKUP"
LOCAL_RETENTION_DAYS=30
LOCAL_COMPRESSION=true

# Cloud sync settings
CLOUD_ENABLED=false
CLOUD_DIR="$DEFAULT_CLOUD_DIR"
CLOUD_SERVICE="nextcloud"  # nextcloud, dropbox, googledrive, pcloud

# Directories to backup (space-separated)
BACKUP_DIRS="
    \$HOME/Documents
    \$HOME/Pictures
    \$HOME/Videos
    \$HOME/Music
    \$HOME/.config
    \$HOME/.local/share
"

# Files/directories to exclude (space-separated)
EXCLUDE_PATTERNS="
    *.tmp
    *.cache
    node_modules
    .git
    __pycache__
    .venv
    venv
"

# System snapshot settings
SYSTEM_SNAPSHOTS=false
SNAPSHOT_SCHEDULE="weekly"  # daily, weekly, monthly

# Auto-sync settings
AUTO_SYNC=false
SYNC_INTERVAL_MINUTES=60

# Notification settings
NOTIFY_ON_COMPLETE=true
NOTIFY_ON_ERROR=true
EOF
        ok "Created default config: $CONFIG_FILE"
    fi
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi
    
    # Set defaults
    LOCAL_BACKUP_DIR="${LOCAL_BACKUP_DIR:-$DEFAULT_LOCAL_BACKUP}"
    LOCAL_RETENTION_DAYS="${LOCAL_RETENTION_DAYS:-30}"
    CLOUD_DIR="${CLOUD_DIR:-$DEFAULT_CLOUD_DIR}"
    CLOUD_SERVICE="${CLOUD_SERVICE:-nextcloud}"
}

# =============================================================================
# STATUS — Show backup status
# =============================================================================
cmd_status() {
    hdr "Backup Status"
    
    load_config
    
    # Local backup status
    echo -e "${BLD}Local Backup:${RST}"
    echo "  Location: $LOCAL_BACKUP_DIR"
    
    if [[ -d "$LOCAL_BACKUP_DIR" ]]; then
        local backup_count last_backup size
        backup_count=$(find "$LOCAL_BACKUP_DIR" -name "*.tar.gz" -o -name "*.tar.bz2" 2>/dev/null | wc -l || true)
        last_backup=$(find "$LOCAL_BACKUP_DIR" -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2- || true)
        size=$(du -sh "$LOCAL_BACKUP_DIR" 2>/dev/null | cut -f1 || true)
        
        ok "  Status: Active"
        echo "  Backups: $backup_count"
        echo "  Size: $size"
        if [[ -n "$last_backup" ]]; then
            local last_date
            last_date=$(date -r "$last_backup" '+%Y-%m-%d %H:%M' 2>/dev/null || stat -c %y "$last_backup" 2>/dev/null | cut -d' ' -f1)
            echo "  Last backup: $last_date"
        fi
    else
        warn "  Status: Not initialized"
    fi
    
    # Cloud sync status
    echo ""
    echo -e "${BLD}Cloud Sync:${RST}"
    echo "  Service: $CLOUD_SERVICE"
    echo "  Location: $CLOUD_DIR"
    
    if [[ -d "$CLOUD_DIR" ]]; then
        local cloud_status
        cloud_status=$(df "$CLOUD_DIR" 2>/dev/null | tail -1 | awk '{print $4}' || true)
        if [[ -n "$cloud_status" ]]; then
            ok "  Status: Available"
            local cloud_size
            cloud_size=$(du -sh "$CLOUD_DIR" 2>/dev/null | cut -f1 || true)
            echo "  Synced data: $cloud_size"
        else
            warn "  Status: Not mounted"
        fi
    else
        warn "  Status: Not configured"
    fi
    
    # Daemon status
    echo ""
    echo -e "${BLD}Auto-Backup Service:${RST}"
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        ok "  Status: Running (PID: $(cat "$PID_FILE"))"
    else
        info "  Status: Not running"
    fi
    
    # Recent log entries
    if [[ -f "$LOG_FILE" ]]; then
        echo ""
        echo -e "${BLD}Recent Activity:${RST}"
        tail -5 "$LOG_FILE" 2>/dev/null | sed 's/^/  /'
    fi
    
    echo ""
}

# =============================================================================
# BACKUP — Create local backup
# =============================================================================
cmd_backup() {
    load_config
    
    hdr "Creating Local Backup"
    
    local backup_type="${1:-full}"
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local hostname
    hostname=$(hostname)
    
    # Create backup directory
    mkdir -p "$LOCAL_BACKUP_DIR"
    
    # Determine backup filename
    local backup_file
    case "$backup_type" in
        full)
            backup_file="${LOCAL_BACKUP_DIR}/backup_full_${hostname}_${timestamp}.tar.bz2"
            ;;
        quick|incremental)
            backup_file="${LOCAL_BACKUP_DIR}/backup_quick_${hostname}_${timestamp}.tar.gz"
            ;;
        config)
            backup_file="${LOCAL_BACKUP_DIR}/backup_config_${hostname}_${timestamp}.tar.gz"
            ;;
        *)
            die "Unknown backup type: $backup_type (full/quick/config)"
            ;;
    esac
    
    info "Backup type: $backup_type"
    info "Destination: $backup_file"
    log "Starting $backup_type backup to $backup_file"
    
    # Build exclude options
    local exclude_opts=""
    for pattern in $EXCLUDE_PATTERNS; do
        exclude_opts="$exclude_opts --exclude=$pattern"
    done
    
    # Build backup command based on type
    local tar_opts=""
    case "$backup_type" in
        full)
            tar_opts="-cjf"
            # Backup all configured directories
            (
                cd "$HOME"
                for dir in $BACKUP_DIRS; do
                    # Expand $HOME if present
                    dir="${dir/\$HOME/$HOME}"
                    if [[ -d "$dir" ]]; then
                        realpath --relative-to="$HOME" "$dir" 2>/dev/null || echo "$dir"
                    fi
                done
            ) | tar "$tar_opts" "$backup_file" $exclude_opts -C "$HOME" -T -
            ;;
            
        quick)
            tar_opts="-czf"
            # Quick backup: only Documents, Desktop, Downloads
            tar "$tar_opts" "$backup_file" $exclude_opts -C "$HOME" \
                Documents Desktop Downloads 2>/dev/null || \
            tar "$tar_opts" "$backup_file" $exclude_opts -C "$HOME" Documents
            ;;
            
        config)
            tar_opts="-czf"
            # Config-only backup
            tar "$tar_opts" "$backup_file" -C "$HOME" \
                .config .local/share .ssh .gnupg 2>/dev/null || \
            tar "$tar_opts" "$backup_file" -C "$HOME" .config
            ;;
    esac
    
    if [[ $? -eq 0 ]]; then
        ok "Backup completed: $(basename "$backup_file")"
        local size
        size=$(du -h "$backup_file" | cut -f1 || true)
        ok "Size: $size"
        log "Backup completed: $backup_file ($size)"
        
        # Cleanup old backups
        _cleanup_old_backups
        
        # Notify
        if [[ "${NOTIFY_ON_COMPLETE:-true}" == "true" ]]; then
            notify-send "Huawei Backup" "Backup completed: $(basename "$backup_file")" 2>/dev/null || true
        fi
    else
        err "Backup failed"
        log "ERROR: Backup failed"
        if [[ "${NOTIFY_ON_ERROR:-true}" == "true" ]]; then
            notify-send "Huawei Backup" "Backup failed!" --urgency=critical 2>/dev/null || true
        fi
        return 1
    fi
}

# Cleanup old backups
_cleanup_old_backups() {
    load_config
    
    info "Cleaning up backups older than $LOCAL_RETENTION_DAYS days..."
    local count_before count_after
    count_before=$(find "$LOCAL_BACKUP_DIR" -type f 2>/dev/null | wc -l || true)
    
    find "$LOCAL_BACKUP_DIR" -type f -mtime +$LOCAL_RETENTION_DAYS -delete 2>/dev/null || true
    
    count_after=$(find "$LOCAL_BACKUP_DIR" -type f 2>/dev/null | wc -l || true)
    local removed=$((count_before - count_after))
    
    if [[ $removed -gt 0 ]]; then
        info "Removed $removed old backup(s)"
        log "Cleaned up $removed old backups"
    fi
}

# =============================================================================
# SYNC — Sync to cloud
# =============================================================================
cmd_sync() {
    load_config
    
    hdr "Cloud Sync"
    
    # Check if cloud directory exists
    if [[ ! -d "$CLOUD_DIR" ]]; then
        warn "Cloud directory not found: $CLOUD_DIR"
        info "Available cloud sync options:"
        
        # Check common cloud services
        local services=(
            "$HOME/Nextcloud"
            "$HOME/Dropbox"
            "$HOME/Google Drive"
            "$HOME/pCloudDrive"
            "$HOME/OneDrive"
        )
        
        for svc in "${services[@]}"; do
            if [[ -d "$svc" ]]; then
                echo "  Found: $svc"
            fi
        done
        
        return 1
    fi
    
    ok "Cloud service: $CLOUD_SERVICE"
    ok "Cloud directory: $CLOUD_DIR"
    
    # Sync specific directories
    local sync_dirs=("Documents" "Pictures" "Desktop")
    
    for dir in "${sync_dirs[@]}"; do
        local src="$HOME/$dir"
        local dst="$CLOUD_DIR/$dir"
        
        if [[ -d "$src" ]]; then
            info "Syncing $dir..."
            mkdir -p "$dst"
            
            # Use rsync for efficient sync
            if command -v rsync &>/dev/null; then
                rsync -av --update --delete \
                      --exclude='*.tmp' \
                      --exclude='*.cache' \
                      --exclude='node_modules' \
                      "$src/" "$dst/" && \
                    ok "Synced: $dir" || \
                    warn "Sync issues: $dir"
            else
                # Fallback to cp
                cp -r "$src""/." "$dst/" 2>/dev/null && \
                    ok "Copied: $dir" || \
                    warn "Copy failed: $dir"
            fi
        fi
    done
    
    log "Cloud sync completed for $CLOUD_SERVICE"
    ok "Cloud sync complete"
}

# =============================================================================
# SNAPSHOT — System snapshot (timeshift)
# =============================================================================
cmd_snapshot() {
    hdr "System Snapshot"
    
    # Check for timeshift
    if ! command -v timeshift &>/dev/null; then
        warn "timeshift not installed"
        info "Install with: sudo apt install timeshift"
        info "Alternative: Use system backup feature"
        return 1
    fi
    
    local snapshot_type="${1:-hourly}"
    
    case "$snapshot_type" in
        hourly|daily|weekly|monthly|boot)
            info "Creating $snapshot_type snapshot..."
            sudo timeshift --create --comments "Huawei Backup $snapshot_type" --tags "$snapshot_type" && \
                ok "Snapshot created: $snapshot_type" || \
                err "Snapshot failed"
            ;;
        list)
            info "Available snapshots:"
            sudo timeshift --list | grep -E "[0-9]{4}-[0-9]{2}-[0-9]{2}" | head -10 | sed 's/^/  /'
            ;;
        restore)
            warn "This will restore system to selected snapshot"
            read -rp "Enter snapshot date to restore (YYYY-MM-DD): " date
            if [[ -n "$date" ]]; then
                info "Starting restore process..."
                sudo timeshift --restore --date "$date"
            fi
            ;;
        *)
            err "Unknown snapshot type: $snapshot_type"
            echo "Usage: huawei-backup snapshot {hourly|daily|weekly|monthly|boot|list|restore}"
            return 1
            ;;
    esac
}

# =============================================================================
# RESTORE — Restore from backup
# =============================================================================
cmd_restore() {
    load_config
    
    hdr "Restore from Backup"
    
    # List available backups
    info "Available backups:"
    local backups
    backups=$(find "$LOCAL_BACKUP_DIR" -name "*.tar.*" -type f 2>/dev/null | sort -r || true)
    
    if [[ -z "$backups" ]]; then
        err "No backups found in $LOCAL_BACKUP_DIR"
        return 1
    fi
    
    local i=1
    local backup_list=()
    while IFS= read -r backup; do
        local size date
        size=$(du -h "$backup" | cut -f1 || true)
        date=$(date -r "$backup" '+%Y-%m-%d %H:%M' 2>/dev/null || stat -c %y "$backup" | cut -d' ' -f1)
        echo "  $i) $(basename "$backup") [$size] - $date"
        backup_list+=("$backup")
        ((i++))
    done <<< "$backups"
    
    echo ""
    read -rp "Select backup to restore (1-$((i-1)), or 'cancel'): " choice
    
    if [[ "$choice" == "cancel" ]] || ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        info "Restore cancelled"
        return 0
    fi
    
    local selected_idx=$((choice - 1))
    if [[ $selected_idx -lt 0 || $selected_idx -ge ${#backup_list[@]} ]]; then
        err "Invalid selection"
        return 1
    fi
    
    local selected_backup="${backup_list[$selected_idx]}"
    
    warn "This will restore files from:"
    echo "  $(basename "$selected_backup")"
    echo ""
    warn "WARNING: This may overwrite existing files!"
    read -rp "Type 'RESTORE' to confirm: " confirm
    
    if [[ "$confirm" != "RESTORE" ]]; then
        info "Restore cancelled"
        return 0
    fi
    
    # Extract backup
    info "Extracting backup..."
    local extract_dir="$HOME/restore_$(date +%Y%m%d_%H%M%S)"
    mkdir -p "$extract_dir"
    
    case "$selected_backup" in
        *.tar.bz2) tar -xjf "$selected_backup" -C "$extract_dir" ;;
        *.tar.gz)  tar -xzf "$selected_backup" -C "$extract_dir" ;;
    esac
    
    if [[ $? -eq 0 ]]; then
        ok "Backup extracted to: $extract_dir"
        info "Review restored files and copy to desired location"
        info "After review, delete: rm -rf $extract_dir"
        log "Restored backup to $extract_dir"
    else
        err "Restore failed"
        return 1
    fi
}

# =============================================================================
# DAEMON — Auto-backup daemon
# =============================================================================
cmd_daemon() {
    local action="${1:-status}"
    
    case "$action" in
        start)
            if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
                warn "Daemon already running (PID: $(cat "$PID_FILE"))"
                return 1
            fi
            
            load_config
            info "Starting auto-backup daemon..."
            
            # Run in background
            (
                while true; do
                    # Run backup
                    "$0" backup quick 2>/dev/null || true
                    
                    # Sleep for interval
                    sleep $((SYNC_INTERVAL_MINUTES * 60))
                done
            ) &
            
            echo $! > "$PID_FILE"
            ok "Daemon started (PID: $!)"
            log "Daemon started"
            ;;
            
        stop)
            if [[ -f "$PID_FILE" ]]; then
                local pid
                pid=$(cat "$PID_FILE")
                if kill -0 "$pid" 2>/dev/null; then
                    kill "$pid"
                    rm -f "$PID_FILE"
                    ok "Daemon stopped"
                    log "Daemon stopped"
                else
                    warn "Daemon not running"
                    rm -f "$PID_FILE"
                fi
            else
                warn "Daemon not running"
            fi
            ;;
            
        restart)
            cmd_daemon stop
            sleep 1
            cmd_daemon start
            ;;
            
        status)
            if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
                ok "Daemon running (PID: $(cat "$PID_FILE"))"
            else
                info "Daemon not running"
            fi
            ;;
            
        *)
            err "Unknown daemon action: $action"
            echo "Usage: huawei-backup daemon {start|stop|restart|status}"
            return 1
            ;;
    esac
}

# =============================================================================
# CONFIG — Configuration management
# =============================================================================
cmd_config() {
    local action="${1:-show}"
    
    case "$action" in
        show|view)
            if [[ -f "$CONFIG_FILE" ]]; then
                hdr "Current Configuration"
                cat "$CONFIG_FILE"
            else
                warn "No config file found. Run: huawei-backup init"
            fi
            ;;
            
        edit)
            ${EDITOR:-nano} "$CONFIG_FILE"
            ;;
            
        init)
            init_config
            ;;
            
        test)
            load_config
            hdr "Configuration Test"
            echo "Local backup dir: $LOCAL_BACKUP_DIR"
            echo "Cloud enabled: $CLOUD_ENABLED"
            echo "Cloud service: $CLOUD_SERVICE"
            echo "Backup directories: $BACKUP_DIRS"
            ;;
    esac
}

# =============================================================================
# SCHEDULE — Configure scheduled backups (cron)
# =============================================================================
cmd_schedule() {
    hdr "Backup Scheduling"
    
    local action="${1:-show}"
    
    case "$action" in
        show)
            info "Current cron jobs:"
            crontab -l 2>/dev/null | grep huawei-backup | sed 's/^/  /' || \
                info "No scheduled backups found"
            ;;
            
        daily)
            # Add daily backup at 2 AM
            (crontab -l 2>/dev/null; echo "0 2 * * * $(realpath "$0") backup quick") | crontab -
            ok "Daily backup scheduled for 2:00 AM"
            ;;
            
        weekly)
            # Add weekly backup on Sunday at 3 AM
            (crontab -l 2>/dev/null; echo "0 3 * * 0 $(realpath "$0") backup full") | crontab -
            ok "Weekly backup scheduled for Sunday 3:00 AM"
            ;;
            
        hourly)
            # Add hourly backup (quick/config only)
            (crontab -l 2>/dev/null; echo "0 * * * * $(realpath "$0") backup config") | crontab -
            ok "Hourly config backup scheduled"
            ;;
            
        remove)
            crontab -l 2>/dev/null | grep -v huawei-backup | crontab -
            ok "All scheduled backups removed"
            ;;
            
        *)
            err "Unknown schedule action: $action"
            echo "Usage: huawei-backup schedule {show|daily|weekly|hourly|remove}"
            return 1
            ;;
    esac
}

# =============================================================================
# HELP
# =============================================================================
cmd_help() {
    cat << 'EOF'

huawei-backup — Automated backup and sync for Huawei MateBook

Usage: huawei-backup <command> [subcommand] [args]

Backup Commands:
  backup full              Create full backup (all configured directories)
  backup quick             Quick backup (Documents, Desktop, Downloads)
  backup config            Backup configuration files only
  restore                  Restore from a previous backup
  status                   Show backup status and recent activity

Cloud Sync:
  sync                     Sync to configured cloud service

System Snapshots (requires timeshift):
  snapshot hourly          Create hourly system snapshot
  snapshot daily           Create daily system snapshot
  snapshot weekly          Create weekly system snapshot
  snapshot list            List available snapshots
  snapshot restore         Restore system from snapshot

Auto-Backup:
  daemon start             Start auto-backup daemon
  daemon stop              Stop auto-backup daemon
  daemon status            Check daemon status
  schedule daily           Schedule daily backups (cron)
  schedule weekly          Schedule weekly backups
  schedule hourly          Schedule hourly config backups
  schedule show            Show scheduled backups
  schedule remove          Remove all scheduled backups

Configuration:
  config init              Initialize configuration
  config show              View current configuration
  config edit              Edit configuration file
  config test              Test configuration

Examples:
  huawei-backup backup full
  huawei-backup backup quick
  huawei-backup restore
  huawei-backup sync
  huawei-backup schedule weekly
  huawei-backup daemon start

Configuration file: ~/.config/huawei-backup/config

EOF
}

# =============================================================================
# Main dispatcher
# =============================================================================
main() {
    local cmd="${1:-status}"
    shift 2>/dev/null || true
    
    case "$cmd" in
        status|s)           cmd_status "$@" ;;
        backup|b)           cmd_backup "$@" ;;
        restore|r)          cmd_restore "$@" ;;
        sync|cloud|c)       cmd_sync "$@" ;;
        snapshot|snap)      cmd_snapshot "$@" ;;
        daemon|d)           cmd_daemon "$@" ;;
        schedule|cron)      cmd_schedule "$@" ;;
        config|cfg)         cmd_config "$@" ;;
        help|-h|--help)     cmd_help ;;
        *)
            err "Unknown command: $cmd"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
